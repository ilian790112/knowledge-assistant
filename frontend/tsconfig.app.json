{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,

        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],

        "module": "ESNext",
        "moduleResolution": "Bundler",

        "jsx": "react-jsx",

        "strict": true,

        "allowJs": false,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "forceConsistentCasingInFileNames": true,

        "skipLibCheck": true,

        "types": [
            "vite/client"
        ]
    },

    "include": [
        "src"
    ]
}